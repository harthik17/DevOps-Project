# ==============================================================================
# Explainable AI-Driven AIOps Framework - Environment Configuration Template
# Copy this file to '.env' and adjust values for your local or production deployment.
# ==============================================================================

# Server Hosting Configuration
HOST=0.0.0.0
PORT=8000

# Prometheus Observability Connection
# Use http://prometheus:9090 when running inside Docker Compose.
# Use http://localhost:9090 when running directly on host Windows.
PROMETHEUS_URL=http://prometheus:9090

# Kubernetes Remediation Security Guardrails
# CRITICAL: Keep AIOPS_ALLOW_K8S_EXECUTION set to false (dry-run mode).
# Never enable automated cluster execution without explicit authorization and audit logging.
AIOPS_ALLOW_K8S_EXECUTION=false
KUBECTL_PATH=kubectl
AIOPS_ALLOWED_NAMESPACES=default
AIOPS_ALLOWED_DEPLOYMENTS=aiops-app

# Optional Cloudflare Quick Tunnel Configuration
CLOUDFLARE_TUNNEL_PORT=8000
